server {
    listen 80;
    server_name example.com;
    root /var/www/visual-learning-lab/dist;
    index index.html;

    # Hash routing: the server receives only /, not #/lessons/1.
    location / {
        try_files $uri $uri/ =404;
    }

    location /assets/ {
        expires 7d;
        add_header Cache-Control "public";
    }
}
